// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
} 

//client config

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core Models


model Task {
  id          String   @id @default(uuid())
  name        String
  description String?
  status      String   @default("pending") // pending | in_progress | completed | failed
  priority    String   @default("medium")  // low | medium | high | critical
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  actions Action[]

  @@map("tasks")
}

model Action {
  id         String    @id @default(uuid())
  taskId     String    @map("task_id")
  type       String    // query | mutation | api_call | script
  payload    Json      @default("{}")
  status     String    @default("pending") // pending | approved | denied | executed
  executedAt DateTime? @map("executed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  task            Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  policyDecisions PolicyDecision[]
  executions      Execution[]

  @@map("actions")
}

model Policy {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  rules       Json     @default("[]") // array of rule objects
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  decisions PolicyDecision[]

  @@map("policies")
}

model PolicyDecision {
  id        String   @id @default(uuid())
  policyId  String   @map("policy_id")
  actionId  String   @map("action_id")
  decision  String   // ALLOW | DENY | ESCALATE
  reason    String?
  decidedAt DateTime @default(now()) @map("decided_at")

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@map("policy_decisions")
}

model Execution {
  id          String    @id @default(uuid())
  actionId    String    @map("action_id")
  status      String    @default("pending") // pending | running | success | failed
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  result      Json?
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@map("executions")
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type") // task | action | policy | execution
  entityId   String   @map("entity_id")
  operation  String   // CREATE | UPDATE | DELETE
  actor      String   @default("system")
  changes    Json     @default("{}")
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

model MockEnvironment {
  id           String   @id @default(uuid())
  tableName    String   @unique @map("table_name")
  rowCount     Int      @map("row_count")
  lastBackupAt DateTime @map("last_backup_at")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("mock_environment")
}
